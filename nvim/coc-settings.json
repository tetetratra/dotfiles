{
  "languageserver": {
    "_memo": "参考: https://github.com/neoclide/coc.nvim/wiki/Language-servers#using-shopifyruby-lsp",

    "ruby-lsp": {
      "command": "ruby-lsp",
      "initializationOptions": {
        "enabledFeatures": {
          "codeActions": true,
          "codeLens": true,
          "completion": true,
          "definition": true,
          "diagnostics": true,
          "documentHighlights": true,
          "documentLink": true,
          "documentSymbols": true,
          "foldingRanges": true,
          "formatting": true,
          "hover": true,
          "inlayHint": true,
          "onTypeFormatting": true,
          "selectionRanges": true,
          "semanticHighlighting": true,
          "signatureHelp": true,
          "typeHierarchy": true,
          "workspaceSymbol": true
        }
      },
      "filetypes": ["ruby"],
      "featuresConfiguration": {
        "inlayHint": {
          "implicitHashValue": true,
          "implicitRescue": true
        }
      },
      "indexing": {
        "excludedPatterns": ["path/to/excluded/file.rb"],
        "includedPatterns": ["path/to/included/file.rb"],
        "excludedGems": ["gem1", "gem2", "etc."],
        "excludedMagicComments": ["compiled:true"]
      },
      "formatter": "auto",
      "linters": [],
      "experimentalFeaturesEnabled": false
    },

    "_memo": "使うには terraform init する必要がある",
    "terraform": {
      "command": "terraform-ls",
      "args": ["serve"],
      "filetypes": ["terraform", "tf"],
      "initializationOptions": {},
      "settings": {}
    },

    "_memo": "参考: https://docs.basedpyright.com/latest/installation/command-line-and-language-server/",
    "basedpyright": {
      "command": "basedpyright-langserver",
      "args": ["--stdio"],
      "filetypes": ["python"],
      "rootPatterns": ["pyproject.toml", "setup.py", "setup.cfg", "requirements.txt", "pyrightconfig.json", ".git"],
      "settings": {
        "basedpyright": {
          "analysis": {
            "typeCheckingMode": "standard"
          }
        }
      }
    },

    "gopls": {
      "command": "gopls",
      "filetypes": ["go"]
    },

    "eslint.autoFixOnSave": true,
    "eslint.filetypes": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact",
      "vue"
    ]
  }
}
